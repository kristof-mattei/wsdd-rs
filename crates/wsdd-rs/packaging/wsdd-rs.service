[Unit]
Description=Web Services Dynamic Discovery host daemon
Documentation=https://github.com/kristof-mattei/wsdd-rs
After=network-online.target
Wants=network-online.target
; Samba is not required, uncomment to couple the two
;BindsTo=smb.service

[Service]
Type=exec
Environment=WSDD_RS_PARAMS=
; Use /etc/default/wsdd-rs for defaults, if it exists
EnvironmentFile=-/etc/default/wsdd-rs
ExecStart=/usr/bin/wsdd-rs $WSDD_RS_PARAMS
DynamicUser=yes
User=wsdd-rs
Group=wsdd-rs
ProtectHome=yes
PrivateDevices=yes
RuntimeDirectory=wsdd-rs

[Install]
WantedBy=multi-user.target
