[Unit]
Description=Web Services Dynamic Discovery client daemon
Documentation=https://github.com/kristof-mattei/wsdd-rs
; started on demand by wsdd-rs-discovery.socket, which passes the API socket in through sd_listen_fds(3), hence no [Install] section
Requires=wsdd-rs-discovery.socket

[Service]
Type=exec
; Use /etc/default/wsdd-rs for defaults, if it exists
EnvironmentFile=-/etc/default/wsdd-rs
; chrooted into its empty runtime directory under /run, the source port differs from the host instance's so both can run on the same machine
ExecStart=/usr/bin/wsdd-rs --chroot=/run/wsdd-rs-discovery --source-port=37020 --no-host --discovery $WSDD_DISCOVERY_PARAMS
DynamicUser=yes
User=wsdd-rs-discovery
Group=wsdd-rs-discovery
RuntimeDirectory=wsdd-rs-discovery
AmbientCapabilities=CAP_SYS_CHROOT
