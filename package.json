{
    "name": "wsdd-rs",
    "private": true,
    "type": "module",
    "scripts": {
        "format": "oxfmt",
        "spellcheck": "cspell --no-progress \"**\"",
        "spellcheck:update": ": > project-words.txt && cspell --no-progress --words-only --unique \"**\" | tr '[:upper:]' '[:lower:]' | LC_ALL=en_US.UTF8 sort --unique > project-words.txt"
    },
    "devDependencies": {
        "cspell": "10.3.0",
        "oxfmt": "0.67.0"
    },
    "engines": {
        "node": "26.8.2"
    },
    "packageManager": "pnpm@12.4.0+sha512.37536c26ed40ab4134b6511e09f6b27f3ebb45687468f2406ca3805279a4e5ca158c1931350ad9774d6ab2108d71b3dbaeb39943159294375e4d053e8e05685c"
}
