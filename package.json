{
    "name": "wsdd-rs",
    "private": true,
    "type": "module",
    "scripts": {
        "format": "oxfmt",
        "spellcheck": "cspell --no-progress \"**\"",
        "spellcheck:update": ": > project-words.txt && cspell --no-progress --words-only --unique \"**\" | tr '[:upper:]' '[:lower:]' | LC_ALL=en_US.UTF8 sort --unique > project-words.txt"
    },
    "devDependencies": {
        "cspell": "10.3.5",
        "oxfmt": "0.71.0"
    },
    "engines": {
        "node": "26.10.0"
    },
    "packageManager": "pnpm@12.8.0+sha512.3916e9559cdfbddf7dc921e8999076584425161de773f6cabf7f47467f0d9452bfa89a689ec245753ad3d55abcb3cf706e667ac12062dbc9c625fbd72bca20dc"
}
